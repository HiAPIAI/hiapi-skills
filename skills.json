{
  "name": "HiAPI Skills",
  "description": "Official HiAPI skill directory for choosing a focused model workflow.",
  "website": {
    "en": "https://www.hiapi.ai/en",
    "zh": "https://www.hiapi.ai/zh"
  },
  "apiKeys": {
    "en": "https://www.hiapi.ai/en/dashboard/api-keys",
    "zh": "https://www.hiapi.ai/zh/dashboard/api-keys"
  },
  "pricing": {
    "en": "https://www.hiapi.ai/en/pricing",
    "zh": "https://www.hiapi.ai/zh/pricing"
  },
  "docs": "https://docs.hiapi.ai",
  "remoteMcp": "https://mcp.hiapi.ai/mcp",
  "publicEntries": [
    {
      "id": "prompt-galleries",
      "name": "Prompt Galleries",
      "url": "https://github.com/HiAPIAI/awesome-gpt-image-2-prompts",
      "useWhen": "Browse tested prompt recipes with output images before generating."
    },
    {
      "id": "agent-skills",
      "name": "Agent Skills",
      "url": "https://github.com/HiAPIAI/hiapi-skills",
      "useWhen": "Browse the available HiAPI skills and choose the one your agent needs."
    },
    {
      "id": "remote-mcp",
      "name": "Remote MCP",
      "url": "https://mcp.hiapi.ai/mcp",
      "useWhen": "Let MCP-compatible clients discover and call HiAPI tools with a user API key."
    },
    {
      "id": "api-cookbook",
      "name": "API Cookbook",
      "url": "https://docs.hiapi.ai",
      "useWhen": "Copy direct API request shapes, model parameters, and integration guides."
    },
    {
      "id": "async-tasks-api",
      "name": "Async Tasks API",
      "url": "https://docs.hiapi.ai/api-reference/",
      "useWhen": "Build server-side integrations that need POST /v1/tasks, status polling, HMAC-signed callbacks, and task history."
    }
  ],
  "integrationGuidance": {
    "skills": "Use local Skills for focused single-model workflows in agent runtimes.",
    "remoteMcp": "Use Remote MCP when a compatible chat client should discover and call multiple HiAPI tools.",
    "asyncTasksApi": "Use /v1/tasks for product code, backend queues, webhook callbacks, polling, and durable task history.",
    "asyncTaskSignature": "Callbacks use X-HiAPI-Timestamp and X-HiAPI-Signature = hex(HMAC-SHA256(secret, timestamp + \".\" + rawBody))."
  },
  "bundles": [
    {
      "id": "hiapi-product-video-skills",
      "name": "HiAPI Product Video Skills",
      "repository": "https://github.com/HiAPIAI/hiapi-product-video-skills",
      "version": "0.1.0",
      "status": "release-candidate",
      "adapters": [
        "ugc-ad",
        "fashion-lookbook",
        "food-commercial",
        "product-spokesperson"
      ],
      "installCommand": "npx -y github:HiAPIAI/hiapi-product-video-skills -y --adapter <adapter>",
      "useWhen": "Install one shared product-video adapter for UGC ads, fashion lookbooks, food commercials, or product spokesperson videos.",
      "documentation": "https://github.com/HiAPIAI/hiapi-skills/blob/main/docs/product-video-skills.md"
    },
    {
      "id": "hiapi-realistic-video-workflow",
      "name": "HiAPI Realistic Video Workflow",
      "repository": "https://github.com/HiAPIAI/hiapi-realistic-video-workflow",
      "version": "1.0.0",
      "status": "archived",
      "installs": [
        "realistic-video-prompting",
        "hiapi-seedance-2-0-video"
      ],
      "installCommand": "npx -y github:HiAPIAI/hiapi-realistic-video-workflow -y",
      "useWhen": "Historical one-command installer for the realistic prompt and Seedance 2.0 skills; keep only for existing automation.",
      "replacement": {
        "documentation": "https://github.com/HiAPIAI/hiapi-skills/blob/main/docs/realistic-video-workflow.md",
        "installCommands": [
          "npx -y github:HiAPIAI/realistic-video-prompting -y",
          "npx -y github:HiAPIAI/hiapi-seedance-2-0-video-skill -y"
        ]
      }
    }
