  "website": {
    "en": "https://www.hiapi.ai/en",
    "zh": "https://www.hiapi.ai/zh"
  },
  "apiKeys": {
    "en": "https://www.hiapi.ai/en/dashboard/api-keys",
    "zh": "https://www.hiapi.ai/zh/dashboard/api-keys"
  },
  "pricing": {
    "en": "https://www.hiapi.ai/en/pricing",
    "zh": "https://www.hiapi.ai/zh/pricing"
  },
  "docs": "https://docs.hiapi.ai",
  "remoteMcp": "https://mcp.hiapi.ai/mcp",
  "publicEntries": [
    {
      "id": "prompt-galleries",
      "name": "Prompt Galleries",
      "url": "https://github.com/HiAPIAI/awesome-gpt-image-2-prompts",
      "useWhen": "Browse tested prompt recipes with output images before generating."
    },
    {
      "id": "agent-skills",
      "name": "Agent Skills",
      "url": "https://github.com/HiAPIAI/hiapi-skills",
      "useWhen": "Browse the available HiAPI skills and choose the one your agent needs."
    },
    {
      "id": "remote-mcp",
      "name": "Remote MCP",
      "url": "https://mcp.hiapi.ai/mcp",
      "useWhen": "Let MCP-compatible clients discover and call HiAPI tools with a user API key."
    },
    {
      "id": "api-cookbook",
      "name": "API Cookbook",
      "url": "https://docs.hiapi.ai",
      "useWhen": "Copy direct API request shapes, model parameters, and integration guides."
    },
    {
      "id": "async-tasks-api",
      "name": "Async Tasks API",
      "url": "https://docs.hiapi.ai/api-reference/",
      "useWhen": "Build server-side integrations that need POST /v1/tasks, status polling, HMAC-signed callbacks, and task history."
    }
  ],
  "integrationGuidance": {
    "skills": "Use local Skills for focused single-model workflows in agent runtimes.",
    "remoteMcp": "Use Remote MCP when a compatible chat client should discover and call multiple HiAPI tools.",
    "asyncTasksApi": "Use /v1/tasks for product code, backend queues, webhook callbacks, polling, and durable task history.",
    "asyncTaskSignature": "Callbacks use X-HiAPI-Timestamp and X-HiAPI-Signature = hex(HMAC-SHA256(secret, timestamp + \".\" + rawBody))."
  },
  "skills": [
    {
      "id": "hiapi-gpt-image-2",
      "name": "HiAPI GPT Image 2",
      "model": "gpt-image-2",
      "type": "image",
      "capabilities": [
        "text-to-image",
        "image-to-image"
      ],
      "bestFor": [
        "posters",
        "illustrations",
        "social media graphics",
        "product visuals",
        "cover images"
      ],
      "repository": "https://github.com/HiAPIAI/hiapi-gpt-image-2-skill",
      "version": "0.1.4",
      "updatePolicy": {
        "latestVersion": "0.1.4",
        "minimumVersion": "0.1.3",
        "updateCommand": "npx -y github:HiAPIAI/hiapi-gpt-image-2-skill -y",
        "notice": "A newer HiAPI GPT Image 2 skill is available.",
        "requiredNotice": "This HiAPI GPT Image 2 skill version is missing current GPT Image 2 image-to-image support or may hide the real task failure reason. Update before creating more image tasks."
      },
      "install": {
        "openclaw": "openclaw skills add https://github.com/HiAPIAI/hiapi-gpt-image-2-skill",
        "codex": "mkdir -p \"${CODEX_HOME:-$HOME/.codex}/skills\" && rm -rf \"${CODEX_HOME:-$HOME/.codex}/skills/hiapi-gpt-image-2\" && git clone https://github.com/HiAPIAI/hiapi-gpt-image-2-skill.git \"${CODEX_HOME:-$HOME/.codex}/skills/hiapi-gpt-image-2\"",
        "claudeCode": "mkdir -p \"$HOME/.claude/skills\" && rm -rf \"$HOME/.claude/skills/hiapi-gpt-image-2\" && git clone https://github.com/HiAPIAI/hiapi-gpt-image-2-skill.git \"$HOME/.claude/skills/hiapi-gpt-image-2\"",
        "manualDirectory": "hiapi-gpt-image-2"
      },
      "modelPage": {
        "en": "https://www.hiapi.ai/en/models/gpt-image-2",
        "zh": "https://www.hiapi.ai/zh/models/gpt-image-2"
      }
    },
